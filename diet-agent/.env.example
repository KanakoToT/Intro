# Anthropic API キー (https://platform.claude.com で取得)
ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud Console で作成した OAuth 2.0 クライアント
# (APIとサービス → 認証情報 → OAuthクライアントID → ウェブアプリケーション)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Google Health API の設定
# ↓ 正式な値は developers.google.com/health の Endpoints / Scopes ページで確認して設定
# GOOGLE_HEALTH_API_BASE=https://googlehealth.googleapis.com/v4
# GOOGLE_HEALTH_SCOPES=https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly https://www.googleapis.com/auth/googlehealth.body_measurements.readonly
